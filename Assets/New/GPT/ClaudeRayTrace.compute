// TreeRaytrace.compute
#pragma kernel CSMain

StructuredBuffer<int4> blocks_int4; // we store block data as two int4s (for alignment)
StructuredBuffer<int> children;     // flat children array (child node indices), -1 = none
StructuredBuffer<int> leaves;       // flat leaves array (0 = empty, >0 = occupied)

RWTexture2D<float4> Result;

int screenWidth;
int screenHeight;
int root;
float nearPlane;
float farPlane;
int maxSteps;
float stepSize;

float4x4 camToWorld;
float4x4 camInverseProjection;

// helper: read GPUBlockData from two int4s
void ReadBlock(int idx, out int type, out int renderState, out int childrenOffset, out int leavesOffset, out int depth, out int parent, out int localPos)
{
    // each block stored as two int4s: blocks_int4[ idx*2 ], blocks_int4[idx*2 + 1]
    int baseIdx = idx * 2;
    int4 a = blocks_int4[baseIdx];
    int4 b = blocks_int4[baseIdx + 1];
    type = a.x;
    renderState = a.y;
    childrenOffset = a.z;
    leavesOffset = a.w;
    depth = b.x;
    parent = b.y;
    localPos = b.z;
}

// Helper function to convert 3D coordinates to linear index
int Child3ToIndex(int x, int y, int z)
{
    return x + 16 * y + 256 * z;
}

// Helper function to convert linear index back to 3D coordinates
void IndexToChild3(int index, out int x, out int y, out int z)
{
    x = index % 16;
    y = (index / 16) % 16;
    z = index / 256;
}

// Get the relative bounds of a node within a root node's coordinate system
void GetRelativeNodeBounds(int nodeIndex, int rootNode, out float3 origin, out float nodeSize)
{
    if (nodeIndex < 0 || rootNode < 0)
    {
        origin = float3(0, 0, 0);
        nodeSize = 0;
        return;
    }
    
    // If this is the root node itself, it occupies the unit cube
    if (nodeIndex == rootNode)
    {
        origin = float3(0, 0, 0);
        nodeSize = 1.0;
        return;
    }
    
    // Build path from nodeIndex up to rootNode
    int path[64];
    int pathLength = 0;
    int currentNode = nodeIndex;
    
    while (currentNode != rootNode && currentNode >= 0 && pathLength < 64)
    {
        int type, renderState, childrenOffset, leavesOffset, depth, parent, localPos;
        ReadBlock(currentNode, type, renderState, childrenOffset, leavesOffset, depth, parent, localPos);
        
        if (parent < 0) break; // reached world root without finding rootNode
        
        path[pathLength] = localPos;
        pathLength++;
        currentNode = parent;
    }
    
    // If we didn't reach the rootNode, the nodeIndex is not a descendant
    if (currentNode != rootNode)
    {
        origin = float3(0, 0, 0);
        nodeSize = 0;
        return;
    }
    
    // Now calculate position within the root's unit cube
    origin = float3(0, 0, 0);
    nodeSize = 1.0;
    
    // Traverse back down the path
    for (int i = pathLength - 1; i >= 0; i--)
    {
        float childSize = nodeSize / 16.0;
        int x, y, z;
        IndexToChild3(path[i], x, y, z);
        origin += float3(x, y, z) * childSize;
        nodeSize = childSize;
    }
}

// Find neighbor of a node in a given direction, relative to a specific root
// direction: 0=+X, 1=-X, 2=+Y, 3=-Y, 4=+Z, 5=-Z
int FindNeighborRelativeToRoot(int nodeIndex, int direction, int rootNode)
{
    if (nodeIndex < 0 || rootNode < 0) return -1;
    
    int type, renderState, childrenOffset, leavesOffset, depth, parent, localPos;
    ReadBlock(nodeIndex, type, renderState, childrenOffset, leavesOffset, depth, parent, localPos);
    
    // If we're at the specified root, no neighbors within this coordinate system
    if (nodeIndex == rootNode || parent < 0) return -1;
    
    // Get current position within parent
    int x, y, z;
    IndexToChild3(localPos, x, y, z);
    
    // Calculate neighbor position
    int nx = x, ny = y, nz = z;
    switch (direction)
    {
        case 0: nx++; break; // +X
        case 1: nx--; break; // -X
        case 2: ny++; break; // +Y
        case 3: ny--; break; // -Y
        case 4: nz++; break; // +Z
        case 5: nz--; break; // -Z
    }
    
    // If neighbor is within same parent, find it directly
    if (nx >= 0 && nx < 16 && ny >= 0 && ny < 16 && nz >= 0 && nz < 16)
    {
        int parentType, parentRenderState, parentChildrenOffset, parentLeavesOffset, parentDepth, grandParent, parentLocalPos;
        ReadBlock(parent, parentType, parentRenderState, parentChildrenOffset, parentLeavesOffset, parentDepth, grandParent, parentLocalPos);
        
        if (parentChildrenOffset >= 0)
        {
            int neighborIndex = parentChildrenOffset + Child3ToIndex(nx, ny, nz);
            if (neighborIndex >= 0) return children[neighborIndex];
        }
        return -1;
    }
    
    // Need to go up to find neighbor, but stop at rootNode
    if (parent == rootNode) return -1; // Can't go beyond our root
    
    int ancestorNeighbor = FindNeighborRelativeToRoot(parent, direction, rootNode);
    if (ancestorNeighbor < 0) return -1;
    
    // Now descend back down to the appropriate child
    int ancestorType, ancestorRenderState, ancestorChildrenOffset, ancestorLeavesOffset, ancestorDepth, ancestorParent, ancestorLocalPos;
    ReadBlock(ancestorNeighbor, ancestorType, ancestorRenderState, ancestorChildrenOffset, ancestorLeavesOffset, ancestorDepth, ancestorParent, ancestorLocalPos);
    
    if (ancestorChildrenOffset < 0) return -1;
    
    // Wrap coordinates to opposite side
    switch (direction)
    {
        case 0: nx = 0; break;  // +X -> leftmost
        case 1: nx = 15; break; // -X -> rightmost
        case 2: ny = 0; break;  // +Y -> bottom
        case 3: ny = 15; break; // -Y -> top
        case 4: nz = 0; break;  // +Z -> front
        case 5: nz = 15; break; // -Z -> back
    }
    
    int neighborChildIndex = ancestorChildrenOffset + Child3ToIndex(nx, ny, nz);
    if (neighborChildIndex >= 0) return children[neighborChildIndex];
    
    return -1;
}

// Generalized sampling function where rootNode represents the unit cube [0,1]³
int SampleTreeFromNode(float3 p, int rootNode)
{
    if (rootNode < 0) return 0;
    
    // p is in [0,1]³ relative to rootNode. If outside, return 0.
    if (any(p < 0.0) || any(p > 1.0)) return 0;
    
    // Start traversal at the root node (which represents the unit cube)
    int node = rootNode;
    float nodeSize = 1.0;              // Root always represents unit cube
    float3 nodeOrigin = float3(0, 0, 0); // Root always starts at origin
    int iter = 0;
    
    while (true)
    {
        iter++;
        if (iter > 64) return 0;
        
        int type, renderState, childrenOffset, leavesOffset, depth, parent, localPos;
        ReadBlock(node, type, renderState, childrenOffset, leavesOffset, depth, parent, localPos);
        
        // If we have children, step into the correct child voxel
        if (childrenOffset >= 0)
        {
            float childSize = nodeSize / 16.0;
            float3 local = (p - nodeOrigin) / childSize;
            int cx = clamp((int)floor(local.x), 0, 15);
            int cy = clamp((int)floor(local.y), 0, 15);
            int cz = clamp((int)floor(local.z), 0, 15);
            int childIndex = childrenOffset + Child3ToIndex(cx, cy, cz);
            if (childIndex < 0) return 0;
            int childNode = children[childIndex];
            if (childNode < 0)
            {
                return 0; // no child here -> empty
            }
            
            // Descend
            nodeOrigin += float3(cx, cy, cz) * childSize;
            nodeSize = childSize;
            node = childNode;
            continue;
        }
        
        // If this node has leaves, sample there
        if (leavesOffset >= 0)
        {
            float childSize = nodeSize / 16.0;
            float3 local = (p - nodeOrigin) / childSize;
            int cx = clamp((int)floor(local.x), 0, 15);
            int cy = clamp((int)floor(local.y), 0, 15);
            int cz = clamp((int)floor(local.z), 0, 15);
            int li = leavesOffset + Child3ToIndex(cx, cy, cz);
            if (li < 0) return 0;
            return leaves[li];
        }
        
        // No leaves and no children: treat as empty
        return 0;
    }
    return 0;
}

// Enhanced sampling function that can cross node boundaries within the root's coordinate system
int SampleTreeWithNeighbors(float3 p, int startNode, int rootNode)
{
    // First try sampling within the start node
    float3 startOrigin;
    float startSize;
    GetRelativeNodeBounds(startNode, rootNode, startOrigin, startSize);
    
    // Convert point to startNode's local coordinate system
    if (startSize > 0)
    {
        float3 localP = (p - startOrigin) / startSize;
        int result = SampleTreeFromNode(localP, startNode);
        if (result > 0) return result;
    }
    
    // If outside bounds or empty, try to find which neighbor might contain the point
    float3 relativePos = p - startOrigin;
    
    // Check each direction to see if we need to look at neighbors
    for (int dir = 0; dir < 6; dir++)
    {
        bool needsNeighbor = false;
        
        switch (dir)
        {
            case 0: needsNeighbor = relativePos.x >= startSize; break; // +X
            case 1: needsNeighbor = relativePos.x < 0; break;          // -X
            case 2: needsNeighbor = relativePos.y >= startSize; break; // +Y
            case 3: needsNeighbor = relativePos.y < 0; break;          // -Y
            case 4: needsNeighbor = relativePos.z >= startSize; break; // +Z
            case 5: needsNeighbor = relativePos.z < 0; break;          // -Z
        }
        
        if (needsNeighbor)
        {
            int neighbor = FindNeighborRelativeToRoot(startNode, dir, rootNode);
            if (neighbor >= 0)
            {
                float3 neighborOrigin;
                float neighborSize;
                GetRelativeNodeBounds(neighbor, rootNode, neighborOrigin, neighborSize);
                
                if (neighborSize > 0)
                {
                    float3 neighborLocalP = (p - neighborOrigin) / neighborSize;
                    int result = SampleTreeFromNode(neighborLocalP, neighbor);
                    if (result > 0) return result;
                }
            }
        }
    }
    
    return 0; // Not found in any neighbor
}

// Original function maintained for compatibility
int SampleTree(float3 p)
{
    return SampleTreeFromNode(p, root);
}

// DDA-based hierarchical voxel traversal
struct DDARaycastHit
{
    bool hit;
    int value;
    float3 position;
    float3 normal;  // Surface normal of hit face
    int steps;
};

// Get the smallest possible voxel size in the tree (for DDA step sizing)
float GetMinVoxelSize()
{
    // Since each level subdivides by 16x, and we have a reasonable max depth limit,
    // we can calculate the theoretical minimum voxel size.
    // For a hierarchical 16^3 tree, typical max depth is around 4-6 levels.
    // We'll use a conservative estimate based on your tree structure.
    
    // If leaves represent the finest level (16^3 within a node), 
    // and nodes can be nested several levels deep:
    // Level 0: 1.0 (root)
    // Level 1: 1.0/16 (first subdivision) 
    // Level 2: 1.0/(16*16) (if nodes have child nodes)
    // Level N: 1.0/pow(16, N)
    
    // For practical DDA, we want a step size that won't miss details
    // but isn't unnecessarily small. A reasonable approach is to use
    // a fixed small step size based on expected tree depth.
    
    return 1.0 / (16.0 * 16.0 * 16.0); // Assumes ~3 levels max for good performance
}

bool IsOpaque(int t)
{
    return (t & 3) != 0;
}

// DDA raycast through the voxel hierarchy
DDARaycastHit DDARaycast(float3 rayOrigin, float3 rayDir, float maxDistance)
{
    DDARaycastHit result;
    result.hit = false;
    result.value = 0;
    result.position = float3(0, 0, 0);
    result.normal = float3(0, 0, 0);
    result.steps = 0;
    
    // Normalize ray direction to avoid issues
    rayDir = normalize(rayDir);
    
    // Find intersection with unit cube [0,1]^3
    float3 invDir = 1.0 / (rayDir + sign(rayDir) * 1e-6); // Avoid division by zero, preserve sign
    float3 t1 = (0.0 - rayOrigin) * invDir;
    float3 t2 = (1.0 - rayOrigin) * invDir;
    float3 tmin = min(t1, t2);
    float3 tmax = max(t1, t2);
    
    float tenter = max(max(tmin.x, tmin.y), tmin.z);
    float texit = min(min(tmax.x, tmax.y), tmax.z);
    
    // No intersection with cube or ray pointing away
    if (tenter >= texit || texit < 0.0) return result;
    
    // Start ray at entry point (or ray origin if already inside)
    float tstart = max(tenter, 0.0);
    float3 startPos = rayOrigin + rayDir * tstart;
    
    // Clamp to unit cube bounds to handle floating point precision issues
    startPos = clamp(startPos, 0.0001, 0.9999);
    
    // Fixed step size for consistent DDA traversal
    float voxelSize = GetMinVoxelSize();
    
    // DDA setup - work in voxel grid coordinates
    int3 mapPos = int3(floor(startPos / voxelSize));
    int3 stepDir = int3(sign(rayDir));
    
    // Prevent zero step direction (ray parallel to axis)
    if (stepDir.x == 0) stepDir.x = 1;
    if (stepDir.y == 0) stepDir.y = 1;
    if (stepDir.z == 0) stepDir.z = 1;
    
    // Calculate delta distances (distance along ray to cross one voxel)
    float3 deltaDist = abs(voxelSize / rayDir);
    
    // Calculate initial side distances
    float3 sideDist;
    float3 currentVoxelPos = float3(mapPos) * voxelSize;
    
    if (rayDir.x > 0) {
        sideDist.x = ((mapPos.x + 1) * voxelSize - startPos.x) / rayDir.x;
    } else {
        sideDist.x = (startPos.x - mapPos.x * voxelSize) / (-rayDir.x);
    }
    
    if (rayDir.y > 0) {
        sideDist.y = ((mapPos.y + 1) * voxelSize - startPos.y) / rayDir.y;
    } else {
        sideDist.y = (startPos.y - mapPos.y * voxelSize) / (-rayDir.y);
    }
    
    if (rayDir.z > 0) {
        sideDist.z = ((mapPos.z + 1) * voxelSize - startPos.z) / rayDir.z;
    } else {
        sideDist.z = (startPos.z - mapPos.z * voxelSize) / (-rayDir.z);
    }
    
    // Track which face we hit for normal calculation
    float3 hitNormal = float3(0, 0, 1); // Default normal (in case we start inside a voxel)
    
    // DDA traversal
    float currentDist = tstart;
    int maxVoxelsToCheck = int(ceil(maxDistance / voxelSize)) + 1;
    maxVoxelsToCheck = min(maxVoxelsToCheck, maxSteps); // Respect shader limits
    
    for (int step = 0; step < maxVoxelsToCheck; step++)
    {
        result.steps = step + 1;
        
        // Calculate current world position (center of current voxel)
        float3 currentPos = (float3(mapPos) + 0.5) * voxelSize;
        
        // Check bounds
        if (any(currentPos < 0.0) || any(currentPos > 1.0)) break;
        if (currentDist > maxDistance) break;
        
        // Sample the voxel tree at this position
        int value = SampleTree(currentPos);
        if (IsOpaque(value))
        {
            result.hit = true;
            result.value = value;
            result.position = currentPos;
            result.normal = hitNormal; // Use the normal from the face we just crossed
            return result;
        }
        
        // DDA step - move to next voxel boundary and calculate the normal for the face we're crossing
        if (sideDist.x < sideDist.y && sideDist.x < sideDist.z)
        {
            currentDist = tstart + sideDist.x;
            sideDist.x += deltaDist.x;
            mapPos.x += stepDir.x;
            // Set normal for the X face we're crossing
            hitNormal = float3(stepDir.x > 0 ? -1.0 : 1.0, 0, 0);
        }
        else if (sideDist.y < sideDist.z)
        {
            currentDist = tstart + sideDist.y;
            sideDist.y += deltaDist.y;
            mapPos.y += stepDir.y;
            // Set normal for the Y face we're crossing
            hitNormal = float3(0, stepDir.y > 0 ? -1.0 : 1.0, 0);
        }
        else
        {
            currentDist = tstart + sideDist.z;
            sideDist.z += deltaDist.z;
            mapPos.z += stepDir.z;
            // Set normal for the Z face we're crossing
            hitNormal = float3(0, 0, stepDir.z > 0 ? -1.0 : 1.0);
        }
    }
    
    return result;
}

// very simple normal estimate by sampling neighboring occupancy
float3 EstimateNormal(float3 p)
{
    float eps = 0.002;
    int s = SampleTree(p);
    float dx = SampleTree(p + float3(eps,0,0)) - SampleTree(p - float3(eps,0,0));
    float dy = SampleTree(p + float3(0,eps,0)) - SampleTree(p - float3(0,eps,0));
    float dz = SampleTree(p + float3(0,0,eps)) - SampleTree(p - float3(0,0,eps));
    float3 n = normalize(float3(dx,dy,dz));
    return n;
}


float3 GetColor(int t)
{
    switch (t)
    {
        case 1://World
            return float3(0.0, 1.0, 0.0);
        case 2://Grass
            return float3(0.0, 1.0, 0.0);
        case 3://Dirt
            return float3(1.0, 1.0, 0.0);
        case 5://Dust
            return float3(.3, .3, .3);
        default:
            return float3(1.0, 0.0, 1.0);
    }
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= screenWidth || id.y >= screenHeight) return;

    // generate NDC coordinates [-1,1]
    float u = ( (float)id.x / (float)screenWidth ) * 2.0 - 1.0;
    float v = ( (float)id.y / (float)screenHeight ) * 2.0 - 1.0;
    
    // reconstruct view space ray
    float4 clip = float4(u, v, -1.0, 1.0);
    float4 view = mul(camInverseProjection, clip);
    view /= view.w;
    float4 worldPos4 = mul(camToWorld, view);
    float3 rayOrigin = mul(camToWorld, float4(0,0,0,1)).xyz;
    float3 rayDir = normalize(worldPos4.xyz - rayOrigin);

    // Use DDA raycast instead of uniform ray marching
    DDARaycastHit hit = DDARaycast(rayOrigin, rayDir, farPlane - nearPlane);

    float4 color = float4(0,0,0,0);
    if (hit.hit)
    {
        float3 baseColor = GetColor(hit.value);
        
        // Use the accurate surface normal from DDA
        float3 lightDir = normalize(float3(0.6, 0.7, -0.5));
        float diff = max(0.3, dot(hit.normal, lightDir)); // Ambient + diffuse
        
        // Color based on steps taken (for debugging/visualization)
        float stepFactor = 1.0 - (float)hit.steps / (float)maxSteps;
        color = float4(baseColor * diff * (0.5 + 0.5 * stepFactor), 1.0);
    }
    
    Result[id.xy] = color;
}