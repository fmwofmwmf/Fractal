#pragma kernel CSRaytrace
#pragma kernel CSClear

// Camera matrices
float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;

// Render targets
RWTexture2D<float4> _ResultTexture;
RWTexture2D<float4> _AccumulationTexture;

// Rendering parameters
uint _FrameCount;
uint _MaxBounces;
uint _MaxTraversalDepth;
float _VoxelSize;

// Lighting
float4 _SkyColor;
float3 _SunDirection;
float4 _SunColor;
float _SunIntensity;

// Subtree rendering parameters
float3 _SubtreeOrigin;
int _SubtreeDepthOffset;
bool _UseSubtreeRendering;

// Voxel data
struct BlockData
{
    int id;
    int type;
    int rendered;
    int expanded;
    int isValid;
    int childrenOffset;
    int leavesOffset;
    int pathOffset;
    int pathLength;
    int depth;
    float3 worldPosition;
};

StructuredBuffer<BlockData> _BlockData;
StructuredBuffer<int> _BlockChildren;
StructuredBuffer<int> _BlockLeaves; // Changed from uint to int
StructuredBuffer<int3> _PathData;
int _RootBlockId;

// Constants
#define BLOCK_SIZE 16
#define MAX_RAY_DISTANCE 1000.0
#define EPSILON 0.001

// Ray structure
struct Ray
{
    float3 origin;
    float3 direction;
};

// Hit information
struct Hit
{
    bool valid;
    float distance;
    float3 position;
    float3 normal;
    int voxelType;
    float3 color;
};

// Random number generation
float rand(inout uint state)
{
    state = state * 1664525u + 1013904223u;
    return float(state) * (1.0 / 4294967296.0);
}

uint hash(uint2 v)
{
    return v.x * 1664525u + v.y + 1013904223u;
}

// Create camera ray
Ray CreateCameraRay(float2 uv)
{
    float3 origin = mul(_CameraToWorld, float4(0, 0, 0, 1)).xyz;
    float3 direction = mul(_CameraInverseProjection, float4(uv, 0, 1)).xyz;
    direction = mul(_CameraToWorld, float4(direction, 0)).xyz;
    direction = normalize(direction);
    
    Ray ray;
    ray.origin = origin;
    ray.direction = direction;
    return ray;
}

// Find block by ID with early exit
int FindBlockIndex(int blockId)
{
    uint blockCount, stride;
    _BlockData.GetDimensions(blockCount, stride);
    
    for (uint i = 0; i < blockCount; i++)
    {
        if (_BlockData[i].id == blockId)
            return (int)i;
    }
    return -1;
}

// Get block at specific world position using subtree rendering
int GetBlockAtWorldPosition(float3 worldPos)
{
    // Convert world position to voxel coordinates
    int3 voxelPos = int3(floor((worldPos - _SubtreeOrigin) / _VoxelSize));
    
    if (_UseSubtreeRendering)
    {
        // Direct lookup using world position and block data
        uint blockCount, stride;
        _BlockData.GetDimensions(blockCount, stride);
        
        float bestDistance = 999999.0;
        int bestBlock = -1;
        
        for (uint i = 0; i < blockCount; i++)
        {
            BlockData block = _BlockData[i];
            if (!block.isValid) continue;
            
            // Calculate block bounds
            int blockSize = 1 << max(0, _MaxTraversalDepth - block.depth);
            float3 blockMin = block.worldPosition - float3(blockSize * 0.5);
            float3 blockMax = block.worldPosition + float3(blockSize * 0.5);
            
            // Check if world position is inside this block
            if (all(worldPos >= blockMin) && all(worldPos < blockMax))
            {
                float distance = length(worldPos - block.worldPosition);
                if (distance < bestDistance)
                {
                    bestDistance = distance;
                    bestBlock = (int)i;
                }
            }
        }
        
        return bestBlock;
    }
    else
    {
        // Original hierarchical traversal
        return GetBlockAtPath(voxelPos, _MaxTraversalDepth);
    }
}

// Get block at specific path (original method)
int GetBlockAtPath(int3 worldPos, uint targetDepth)
{
    // Start from root
    int currentBlockId = _RootBlockId;
    if (currentBlockId < 0) return -1;
    
    for (uint depth = 0; depth < targetDepth; depth++)
    {
        int blockIndex = FindBlockIndex(currentBlockId);
        if (blockIndex < 0 || !_BlockData[blockIndex].expanded) 
            return blockIndex;
        
        // Calculate local position within current block
        int blockSize = 1 << (int)(_MaxTraversalDepth - depth - 1);
        int3 localPos = (worldPos / blockSize) % BLOCK_SIZE;
        
        // Get child index
        int childIndex = localPos.x + BLOCK_SIZE * (localPos.y + BLOCK_SIZE * localPos.z);
        if (childIndex >= BLOCK_SIZE * BLOCK_SIZE * BLOCK_SIZE) return blockIndex;
        
        // Get child block ID
        int childrenOffset = _BlockData[blockIndex].childrenOffset;
        if (childrenOffset < 0) return blockIndex;
        
        currentBlockId = _BlockChildren[childrenOffset + childIndex];
    }
    
    return FindBlockIndex(currentBlockId);
}

// Get voxel type at world position
int GetVoxelType(float3 worldPos)
{
    // Get the appropriate block
    int blockIndex = GetBlockAtWorldPosition(worldPos);
    if (blockIndex < 0) return 0;
    
    BlockData block = _BlockData[blockIndex];
    
    if (block.expanded)
    {
        // Block is expanded, should traverse deeper or return empty
        return 0;
    }
    
    // Calculate local voxel position within the block
    int blockSize = 1 << max(0, _MaxTraversalDepth - block.depth);
    float3 localWorldPos = worldPos - (block.worldPosition - float3(blockSize * 0.5));
    int3 localVoxelPos = int3(floor(localWorldPos / _VoxelSize)) % BLOCK_SIZE;
    
    // Ensure local position is within bounds
    if (any(localVoxelPos < 0) || any(localVoxelPos >= BLOCK_SIZE))
        return 0;
    
    // Get voxel from leaves
    int voxelIndex = localVoxelPos.x + BLOCK_SIZE * (localVoxelPos.y + BLOCK_SIZE * localVoxelPos.z);
    if (block.leavesOffset >= 0 && voxelIndex < BLOCK_SIZE * BLOCK_SIZE * BLOCK_SIZE)
    {
        return _BlockLeaves[block.leavesOffset + voxelIndex];
    }
    
    return block.type;
}

// Get voxel color based on type
float3 GetVoxelColor(int voxelType)
{
    switch (voxelType)
    {
        case 0: return float3(0, 0, 0); // Empty
        case 1: return float3(0.2, 0.8, 0.2); // Grass
        case 2: return float3(0.6, 0.4, 0.2); // Dirt
        case 3: return float3(0.5, 0.5, 0.5); // Stone
        case 4: return float3(0.8, 0.8, 0.2); // Sand
        default: return float3(0.8, 0.2, 0.8); // Unknown
    }
}

// DDA voxel traversal
Hit TraceVoxels(Ray ray)
{
    Hit hit = (Hit)0;
    hit.valid = false;
    
    float3 rayPos = ray.origin;
    float3 rayDir = ray.direction;
    
    // DDA setup
    int3 voxelPos = int3(floor(rayPos / _VoxelSize));
    float3 deltaDist = abs(1.0 / rayDir);
    int3 step = int3(sign(rayDir));
    
    float3 sideDist;
    float3 voxelEdge = (voxelPos + max(step, 0)) * _VoxelSize;
    sideDist = (voxelEdge - rayPos) / rayDir;
    
    // DDA traversal
    float totalDistance = 0.0;
    int3 normal = int3(0, 0, 0);
    
    for (int i = 0; i < 1000; i++) // Max iterations to prevent infinite loops
    {
        // Check current voxel
        int voxelType = GetVoxelType(rayPos + rayDir * totalDistance);
        if (voxelType > 0)
        {
            hit.valid = true;
            hit.distance = totalDistance;
            hit.position = rayPos + rayDir * totalDistance;
            hit.normal = float3(normal);
            hit.voxelType = voxelType;
            hit.color = GetVoxelColor(voxelType);
            break;
        }
        
        // Move to next voxel
        if (sideDist.x < sideDist.y && sideDist.x < sideDist.z)
        {
            totalDistance = sideDist.x;
            sideDist.x += deltaDist.x;
            voxelPos.x += step.x;
            normal = int3(-step.x, 0, 0);
        }
        else if (sideDist.y < sideDist.z)
        {
            totalDistance = sideDist.y;
            sideDist.y += deltaDist.y;
            voxelPos.y += step.y;
            normal = int3(0, -step.y, 0);
        }
        else
        {
            totalDistance = sideDist.z;
            sideDist.z += deltaDist.z;
            voxelPos.z += step.z;
            normal = int3(0, 0, -step.z);
        }
        
        // Check if we've gone too far
        if (totalDistance > MAX_RAY_DISTANCE)
            break;
    }
    
    return hit;
}

// Simple lighting calculation
float3 CalculateLighting(Hit hit, Ray ray)
{
    if (!hit.valid) return _SkyColor.rgb;
    
    float3 lightDir = normalize(-_SunDirection);
    float3 normal = normalize(hit.normal);
    
    // Ambient
    float3 ambient = hit.color * 0.2;
    
    // Diffuse
    float NdotL = max(dot(normal, lightDir), 0.0);
    float3 diffuse = hit.color * _SunColor.rgb * _SunIntensity * NdotL;
    
    // Simple shadow test
    Ray shadowRay;
    shadowRay.origin = hit.position + normal * EPSILON * 2.0;
    shadowRay.direction = lightDir;
    Hit shadowHit = TraceVoxels(shadowRay);
    
    if (shadowHit.valid && shadowHit.distance < 50.0) // Shadow distance limit
    {
        diffuse *= 0.3; // Darken if in shadow
    }
    
    return ambient + diffuse;
}

[numthreads(8, 8, 1)]
void CSRaytrace(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _ResultTexture.GetDimensions(width, height);
    
    if (id.x >= width || id.y >= height)
        return;
    
    // Generate random seed for this pixel
    uint rngState = hash(id.xy) + _FrameCount;
    
    // Calculate UV coordinates
    float2 uv = (float2(id.xy) + float2(rand(rngState), rand(rngState))) / float2(width, height);
    uv = uv * 2.0 - 1.0; // Convert to [-1, 1]
    
    // Create primary ray
    Ray ray = CreateCameraRay(uv);
    
    // Trace ray
    Hit hit = TraceVoxels(ray);
    
    // Calculate lighting
    float3 color = CalculateLighting(hit, ray);
    
    // Accumulate samples for anti-aliasing
    if (_FrameCount > 0)
    {
        float4 prevColor = _AccumulationTexture[id.xy];
        color = lerp(prevColor.rgb, color, 1.0 / (_FrameCount + 1.0));
    }
    
    _AccumulationTexture[id.xy] = float4(color, 1.0);
    _ResultTexture[id.xy] = float4(color, 1.0);
}

[numthreads(8, 8, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _AccumulationTexture.GetDimensions(width, height);
    
    if (id.x >= width || id.y >= height)
        return;
        
    _AccumulationTexture[id.xy] = float4(0, 0, 0, 0);
}